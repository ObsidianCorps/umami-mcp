# Umami Cloud (recommended)
UMAMI_API_KEY=

# Self-hosted alternative: comment UMAMI_API_KEY and use either a token or credentials.
# UMAMI_BASE_URL=https://analytics.example.com
# UMAMI_TOKEN=
# UMAMI_USERNAME=
# UMAMI_PASSWORD=
# Umami v3.3+ 2FA: prefer the Base32 setup secret for automatic code generation.
# Treat this seed like a password and use a dedicated least-privilege account.
# UMAMI_TWO_FACTOR_SECRET=
# One-off alternative: a current six-digit code, valid only for this startup.
# UMAMI_TWO_FACTOR_CODE=

# Optional convenience and safety limits
# UMAMI_DEFAULT_WEBSITE_ID=
# UMAMI_TIMEOUT_MS=15000
# UMAMI_MAX_RESPONSE_BYTES=512000

# Mutations are not exposed unless explicitly enabled.
# UMAMI_ENABLE_WRITE_TOOLS=false
# UMAMI_ENABLE_DESTRUCTIVE_TOOLS=false

# Local MCP transport (default)
MCP_TRANSPORT=stdio

# Streamable HTTP example. Non-loopback binds require both a bearer token and host allowlist.
# MCP_TRANSPORT=http
# MCP_HOST=127.0.0.1
# MCP_PORT=3000
# MCP_BEARER_TOKEN=
# MCP_ALLOWED_HOSTS=mcp.example.com
# MCP_ALLOWED_ORIGINS=https://chat.example.com
