{
  "name": "@obsidiancorps/umami-mcp",
  "mcpName": "io.github.obsidiancorps/umami-mcp",
  "version": "0.1.0",
  "description": "A secure, model-friendly MCP server for Umami Analytics v3",
  "type": "module",
  "bin": {
    "umami-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "check": "npm run verify && npm run build",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run check",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "keywords": [
    "analytics",
    "mcp",
    "model-context-protocol",
    "umami"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obsidiancorps/umami-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/obsidiancorps/umami-mcp/issues"
  },
  "homepage": "https://github.com/obsidiancorps/umami-mcp#readme",
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.10.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
